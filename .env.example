# ===========================================================================
# Stock Market AI Agent - Credentials Configuration
# Rename this file to '.env' and fill in your actual tokens.
# ===========================================================================

# 1. Google Gemini Developer API Key (Free from https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. Telegram Bot Configuration
# Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_TOKEN=YourTelegramBotTokenHere

# Chat ID or Channel ID where bot will post (e.g., -100123456789 or @your_channel)
TELEGRAM_CHAT_ID=YourTelegramChatOrChannelIdHere

# 3. Email Notification Configuration (e.g. Gmail SMTP)
# EMAIL_SMTP_SERVER: Mail server address (defaults to smtp.gmail.com)
# EMAIL_SMTP_PORT: Server port (defaults to 587 for TLS)
# EMAIL_SENDER: The sender Gmail address
# EMAIL_PASSWORD: The secure Google App Password generated in Google Settings
# EMAIL_RECEIVER: The target email address to receive reports
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_google_app_password
EMAIL_RECEIVER=receiver_email@gmail.com
