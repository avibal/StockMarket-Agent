# ===========================================================================
# StockMarket-Agent .gitignore
# ===========================================================================

# 1. Security & Environment Credentials (NEVER COMMIT!)
.env
.env.*
.env.local
*.key
*.pem
secrets.*
!*.example

# 2. Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 4. Testing & Linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 5. IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 6. Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# 7. Temporary, Scratch & Log files
*.log
tmp/
scratch/
temp/
